# Copie para config/lab.env na OCI. Nao ha credenciais neste arquivo.
# LAB_ID e acrescentado na etapa 3; preserve-o ao retomar esta instalacao.
# GPUs fisicas vistas no nvidia-smi. Revalide a reserva antes de iniciar.
# Quatro GPUs distintas para o modelo de linguagem.
LLM_GPU_0=0
LLM_GPU_1=1
LLM_GPU_2=2
LLM_GPU_3=3
EMBEDDING_GPU=4
RERANKING_GPU=5
INGEST_GPU=7
# Cole aqui o ID completo de um perfil BF16 TP4 COMPATIVEL,
# obtido com list-model-profiles. Nao escolha FP8/NVFP4 para este roteiro A100.
LLM_PROFILE=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_CONTEXT=32768
LLM_OUTPUT_TOKENS=8192
# Portas do HOST. Dentro do Docker os servicos mantem as portas upstream.
LLM_PORT=18999
RAG_PORT=18081
INGEST_PORT=18082
RAG_UI_PORT=19090
AIQ_PORT=18000
AIQ_UI_PORT=13000
